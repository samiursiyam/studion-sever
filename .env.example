# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/wanderlast

# Shared secret with the Next.js frontend — REQUIRED in production.
# The frontend's /backend proxy verifies the better-auth session and
# re-asserts identity with `x-internal-secret` + `x-user-*` headers.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the frontend project's INTERNAL_API_SECRET (Vercel env).
INTERNAL_API_SECRET=

# better-auth public config — only used by the JWKS Bearer fallback
# (direct API calls). In production, set both to the frontend's origin.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Local port (Vercel sets PORT automatically / uses serverless)
# PORT=5000
